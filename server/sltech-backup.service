[Unit]
Description=SLTech database backup
After=sltech.service

[Service]
Type=oneshot
User=sltech
Group=sltech
Environment=DB_FILE=/var/lib/sltech/sltech.db
Environment=BACKUP_DIR=/var/backups/sltech
Environment=BACKUP_KEEP_DAYS=30
ExecStart=/opt/sltech/app/server/backup.sh
Nice=10
IOSchedulingClass=idle
