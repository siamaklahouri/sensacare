
/* ---------- رنگِ نمودارها ----------
   این‌ها «وضعیت»اند نه «هویت»، پس رنگشان معنا دارد و جابه‌جا نمی‌شود:
   سبز یعنی انجام شده، آبی یعنی در جریان، کهربایی یعنی نشده. خاکستری
   هم «بی‌وضعیت» است، نه یک دستهٔ چهارم.

   گامِ روز و شب جدا انتخاب شده‌اند، نه وارونهٔ خودکارِ هم — و هر دو با
   سنجهٔ کوررنگی بررسی شده‌اند: بدترین جفتِ کنارِ هم در دید عادی ΔE ۲۰
   و در دوترانوپی ۱۸٫۷ فاصله دارد.

   خطِ بینِ تکه‌ها همرنگِ خودِ کارت است، نه سفیدِ ثابت — وگرنه در تمِ شب
   مثل یک قابِ روشن می‌زد بیرون. */
/* دو دسته رنگ، و کارشان فرق دارد:
   • done/doing/todo/bad/none «وضعیت»اند — معنایشان ثابت است و هیچ‌وقت
     برای «سریِ چهارم» قرض داده نمی‌شوند.
   • cat «هویت»‌اند: وقتی برش‌ها یا ستون‌ها فقط با هم فرق دارند، نه
     خوب و بد. ترتیبشان ثابت است و هیچ‌وقت چرخانده نمی‌شود، وگرنه با
     عوض شدنِ یک فیلتر رنگِ بقیه هم عوض می‌شود.

   هر دو ستون با سنجهٔ کوررنگی بررسی شده‌اند. دست بردن در یکی از این
   هگزها یعنی باید دوباره سنجیده شود.

   گامِ تازه (روشن‌تر، به خواستِ صاحبِ کارتابل: «آبیِ روشن، زردِ
   فسفری»): آبیِ سرمه‌ای جایش را به آبیِ روشن داد و کهربایی به زردِ
   طلایی. پیش از جایگزینی، هر سه سنجه دوباره گرفته شد و هیچ‌کدام از
   گامِ قبلی بدتر نشد:

                      کمترین ΔE همسایه   کمترین ΔE زیرِ کوررنگی
     روز، گامِ قبلی        ۱۵٫۴                ۲٫۱
     روز، همین گام         ۲۰٫۷                ۲٫۲
     شب، گامِ قبلی         ۱۸٫۲                ۲٫۲
     شب، همین گام          ۲۷٫۸                ۳٫۳

   کنتراستِ هر رنگ با سطحِ کارت هم گرفته شد: در شب همه بالای ۳٫۴ و در
   روز بین ۲٫۲ (زرد) تا ۴٫۸ (بنفش). زردِ روشن روی کاغذِ سفید ذاتاً
   کنتراستِ کمی دارد؛ چیزی که نگهش می‌دارد، همان قابِ دو پیکسلیِ
   هم‌رنگِ کارت بینِ برش‌هاست که از قبل بود.

   رنگ‌های شب «وارونهٔ» روز نیستند؛ جداگانه روی سطحِ تیره انتخاب
   شده‌اند. مقدارهای قبلیِ شب برای «متن» ساخته شده بودند و برای پر
   کردنِ نمودار از باندِ مجاز روشن‌تر بودند. */
/* رنگِ برندِ تم، همان‌طور که CSS می‌بیندش.
   «cat[0]» رنگِ نمودارهای تک‌سری است — نمودارِ میله‌ایِ شرکت‌ها، مثلاً —
   و هیچ معنایی ندارد جز «این داده». پس باید با تم بچرخد، وگرنه روی
   تمِ بنفش یک ستونِ آبیِ یادگار می‌ماند. بقیهٔ cat سرجایشان‌اند: آن‌ها
   وقتی به کار می‌آیند که چند دسته باید از هم تفکیک شوند، و تفکیک‌پذیری
   کارِ داده است نه تزئین.

   و یک قاعده که بارِ اول از قلم افتاد و کاربر از روی عکس گرفتش: هر
   نمودارِ **تک‌سری** باید cat[0] بگیرد، نه cat[2] یا cat[3]. وقتی
   فقط یک سری هست، رنگ هیچ‌چیز را از هیچ‌چیز جدا نمی‌کند — پس یک
   رنگِ ثابت فقط یک لکهٔ بی‌ربط است کنارِ تمِ کاربر. نمودارِ
   چک‌لیستِ ریموت فیروزه‌ای می‌ماند در حالی که نوارِ قاب‌ها و فهرست
   رنگِ دیگری داشتند. cat[1] به بعد فقط وقتی به کار می‌آیند که چند
   سری کنارِ هم باشند و باید از هم تشخیص داده شوند. */
function brandTone(fallback){
  try{
    const v = getComputedStyle(document.documentElement)
      .getPropertyValue("--brass").trim();
    return v || fallback;
  }catch(e){ return fallback; }
}
function chartTone(){
  const dark = document.documentElement.getAttribute("data-theme") === "dark";
  /* «ink» و «inkFaint» رنگِ نوشته‌اند، نه رنگِ داده: عددی که روی بوم
     کشیده می‌شود (مثلِ عددِ وسطِ دونات یا عددِ روی ستون) باید همان
     خوانایی‌ای را داشته باشد که متنِ کنارِ نمودار دارد. رنگِ متنِ CSS
     را نمی‌شود روی بوم ریخت، پس این‌جا هم می‌آیند. */
  return dark
    ? { done:"#3FBE79", doing:"#5AA8FF", todo:"#F2C033", none:"#3A4653",
        bad:"#F06A72", surface:"#121E29",
        ink:"#E7EEF4", inkFaint:"#8DA0B2",
        cat:[brandTone("#7FC2FF"),"#F2C033","#1FAFA0","#8257D8","#FF9080"] }
    : { done:"#1FA05C", doing:"#2E86F0", todo:"#E8A200", none:"#CFD7E0",
        bad:"#E0484F", surface:"#FFFFFF",
        ink:"#0B2545", inkFaint:"#5B6E82",
        cat:[brandTone("#2E86F0"),"#E8A200","#0FA89C","#7C5CD6","#F2624F"] };
}
/* کمی روشن‌تر برای وقتی موشواره رویش می‌رود */
function chartHover(list){ return list.map(c=> c + "D9"); }
